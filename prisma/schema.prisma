generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  TEXT
  VIDEO
  PDF
  IMAGE
  LINK
  QUIZ
}

model User {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique
  name         String?
  memberships  OrganizationMembership[]
  passwordCredential PasswordCredential?
  sessions     Session[]
  invitations  EmployeeInvitation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([createdAt])
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Organization {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  slug         String                   @unique
  memberships  OrganizationMembership[]
  invitations  EmployeeInvitation[]
  teams        Team[]
  courses      Course[]
  courseModules CourseModule[]
  lessons      Lesson[]
  teamMemberships TeamMembership[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([createdAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  employeeName   String?
  jobTitle       String?
  department     String?
  phone          String?
  employeeNumber String?
  active         Boolean          @default(true)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations    EmployeeInvitation[]
  teamMemberships TeamMembership[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, role])
  @@index([organizationId, createdAt, id])
}

model EmployeeInvitation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  tokenHash      String   @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    TeamMembership[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@unique([id, organizationId])
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  description    String?
  status         CourseStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modules      CourseModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt, id])
}

model CourseModule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  courseId       String   @db.Uuid
  title          String
  description    String?
  position       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lessons      Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([courseId, position])
  @@index([organizationId, courseId, position])
}

model Lesson {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  moduleId       String     @db.Uuid
  title          String
  type           LessonType
  position       Int
  textContent    String?
  contentUrl     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       CourseModule @relation(fields: [moduleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([moduleId, position])
  @@index([organizationId, moduleId, position])
}

model TeamMembership {
  id             String @id @default(uuid()) @db.Uuid

  organizationId String @db.Uuid
  teamId         String @db.Uuid
  membershipId   String @db.Uuid

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team                   @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, membershipId])
  @@index([organizationId, teamId])
  @@index([organizationId, membershipId])
}
