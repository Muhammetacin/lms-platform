{
  "name": "lms-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:health": "node --experimental-strip-types scripts/db-health.mjs",
    "test:db-config": "node --experimental-strip-types --test tests/database-url.test.ts",
    "test:auth": "node --experimental-strip-types --test tests/authentication.test.ts",
    "test:authorization": "node --experimental-strip-types --test tests/authorization.test.ts",
    "test:tenant-context": "node --experimental-strip-types --test tests/tenant-context.test.ts",
    "test:organization-settings": "node --experimental-strip-types --test tests/organization-settings.test.ts",
    "test:employee-management": "node --experimental-strip-types --test tests/employee-management.test.ts",
    "test:employee-profile": "node --experimental-strip-types --test tests/employee-profile.test.ts",
    "test:employee-invitation": "node --experimental-strip-types --test tests/employee-invitation.test.ts",
    "test:team": "node --experimental-strip-types --test tests/team.test.ts",
    "test:team:db": "node --conditions=react-server --experimental-strip-types --test tests/team-postgres.test.ts",
    "test:team-membership": "node --experimental-strip-types --test tests/team-membership.test.ts",
    "test:team-membership:db": "node --conditions=react-server --experimental-strip-types --test tests/team-membership-postgres.test.ts",
    "test:employee-invitation:db": "node --conditions=react-server --experimental-strip-types --test tests/employee-invitation-postgres.test.ts",
    "test:tenant-isolation:db": "node --conditions=react-server --experimental-strip-types --test tests/tenant-isolation-postgres.test.ts tests/employee-profile-postgres.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^18.0.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.6",
    "prisma": "7.3.0",
    "typescript": "5.9.3"
  }
}
