# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email. Create a Brevo API key and verify this sender address/domain first.
# Keep the API key in .env.local or your deployment's secret store; never expose it to the browser.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=LMS Platform

# Local PostgreSQL connection. Replace the placeholders in your ignored .env.local file.
DATABASE_URL="postgresql://lms_app:replace_me@localhost:5432/lms_platform?schema=public"

# Optional development-only owner bootstrap values. Set these in .env.local.
# Use a password of at least 12 characters; no default password is provided.
DEV_BOOTSTRAP_EMAIL=
DEV_BOOTSTRAP_PASSWORD=
DEV_BOOTSTRAP_NAME=
DEV_BOOTSTRAP_ORG_NAME=
DEV_BOOTSTRAP_ORG_SLUG=
